{
  "name": "chikn-game-assets",
  "version": "0.7.0-rc.1",
  "private": true,
  "description": "Publicly hosted Chikn, Roostr, and FarmLand community asset source and runtime distributions.",
  "type": "module",
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run assets:build && npm run build -w @chikn-game-assets/runtime",
    "assets:build": "node scripts/build-assets.mjs",
    "coqfight:verify": "node scripts/import-coqfight-snapshot.mjs",
    "rights:refresh": "node scripts/build-rights-manifest.mjs",
    "rights:validate": "node scripts/verify-rights.mjs",
    "content-terms:validate": "node scripts/verify-content-terms.mjs",
    "legal:validate": "node scripts/verify-legal-pages.mjs",
    "inventory": "node scripts/build-assets.mjs --inventory-only",
    "test": "node --test scripts/test/*.test.mjs && npm test --workspaces --if-present",
    "verify": "node scripts/verify-assets.mjs",
    "animations:coverage": "node scripts/build-trait-animation-coverage.mjs",
    "animations:coverage:verify": "node scripts/build-trait-animation-coverage.mjs --check",
    "distribution:report": "node scripts/report-distribution.mjs",
    "check": "npm run check --workspaces --if-present && npm run rights:validate && npm run content-terms:validate && npm run verify && npm run animations:coverage:verify && npm run distribution:report && node scripts/verify-source-layout.mjs && node scripts/verify-public-tree.mjs && node scripts/verify-lifecycle.mjs",
    "repro:linux": "npm run build && node scripts/repro-linux.mjs",
    "cross:verify": "npm run build && node scripts/cross-repo-verify.mjs",
    "showcase:data": "node scripts/build-showcase-data.mjs",
    "builder:dev": "npm run showcase:data && npm run dev -w chikn-game-assets-showcase -- --host 127.0.0.1 --port 4173",
    "showcase:build": "npm run showcase:data && npm run build -w chikn-game-assets-showcase",
    "test:browser": "playwright test",
    "api:snapshot": "node scripts/runtime-api-snapshot.mjs --write",
    "api:verify": "node scripts/runtime-api-snapshot.mjs",
    "docs:build": "vitepress build docs",
    "pages:build": "npm run legal:validate && npm run build && npm run showcase:build && npm run docs:build && node scripts/assemble-pages.mjs",
    "pack:check": "npm run build && node scripts/verify-pack.mjs",
    "release:sources:stage": "node scripts/stage-release-sources.mjs .release/sources",
    "release:assemble": "npm run build && npm run release:sources:stage && node scripts/assemble-release.mjs",
    "release:verify": "npm ci && npm run build && npm run api:verify && npm test && npm run check && npm run pack:check && npm run release:sources:stage"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@roost2d/assets": "file:vendor/npm/roost2d-assets-0.10.0-rc.1.tgz",
    "@roost2d/audio": "file:vendor/npm/roost2d-audio-0.10.0-rc.1.tgz",
    "@roost2d/blueprint": "file:vendor/npm/roost2d-blueprint-0.10.0-rc.1.tgz",
    "@roost2d/chikn-rigs": "file:vendor/npm/roost2d-chikn-rigs-0.10.0-rc.1.tgz",
    "@roost2d/contracts": "file:vendor/npm/roost2d-contracts-0.10.0-rc.1.tgz",
    "@roost2d/core": "file:vendor/npm/roost2d-core-0.10.0-rc.1.tgz",
    "@roost2d/diagnostics": "file:vendor/npm/roost2d-diagnostics-0.10.0-rc.1.tgz",
    "@roost2d/effects": "file:vendor/npm/roost2d-effects-0.10.0-rc.1.tgz",
    "@roost2d/input": "file:vendor/npm/roost2d-input-0.10.0-rc.1.tgz",
    "@roost2d/isometric": "file:vendor/npm/roost2d-isometric-0.10.0-rc.1.tgz",
    "@roost2d/net": "file:vendor/npm/roost2d-net-0.10.0-rc.1.tgz",
    "@roost2d/pixi": "file:vendor/npm/roost2d-pixi-0.10.0-rc.1.tgz",
    "@roost2d/rig2d": "file:vendor/npm/roost2d-rig2d-0.10.0-rc.1.tgz",
    "@roost2d/tooling": "file:vendor/npm/roost2d-tooling-0.10.0-rc.1.tgz",
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.3"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
